#!/usr/bin/env bash
set -Eeuo pipefail
SLUG="${1:-}"
shift || true
[[ "$SLUG" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || { echo 'invalid slug' >&2; exit 2; }
SECRET="/etc/web-manager/secrets/sites/${SLUG}.env"
OVERRIDE="/etc/web-manager/site-env-compose/${SLUG}.yml"
if [[ -f "$SECRET" ]]; then
  exec docker compose -f compose.yml -f "$OVERRIDE" "$@"
fi
exec docker compose -f compose.yml "$@"
