#!/usr/bin/env bash
set -Eeuo pipefail

# Narrow privileged helper for the unprivileged web-admin service.
# This intentionally does NOT expose arbitrary shell execution.

CMD="${1:-}"
case "$CMD" in
  desktop-start)
    rm -f /run/desktop-commander-manual-stop
    systemctl start desktop-commander-remote.service
    ;;
  desktop-stop)
    printf '%s\n' 'manual stop via web-admin' > /run/desktop-commander-manual-stop
    chmod 0644 /run/desktop-commander-manual-stop
    systemctl stop desktop-commander-remote.service
    ;;
  global-env-status)
    TARGET="/etc/web-manager/secrets/global.env"
    U=false; K=false
    if [[ -f "$TARGET" && ! -L "$TARGET" ]]; then
      grep -q '^SUPABASE_URL=.' "$TARGET" && U=true || true
      grep -q '^SUPABASE_SERVICE_ROLE_KEY=.' "$TARGET" && K=true || true
    fi
    printf '{"supabaseUrl":%s,"supabaseServiceRoleKey":%s}\n' "$U" "$K"
    ;;
  global-env-save)
    STAGED="${2:-}"
    [[ "$STAGED" =~ ^/run/web-admin/global-env-[0-9a-f-]{36}\.env$ ]] || { echo 'invalid staged env' >&2; exit 2; }
    [[ -f "$STAGED" && ! -L "$STAGED" ]] || { echo 'invalid staged env file' >&2; exit 2; }
    [[ "$(stat -c '%U' "$STAGED")" == 'webadmin' ]] || { echo 'invalid staged env owner' >&2; exit 2; }
    grep -q '^SUPABASE_URL=https://[A-Za-z0-9-]*\.supabase\.co/?$' "$STAGED" || { echo 'invalid Supabase URL' >&2; exit 2; }
    grep -q '^SUPABASE_SERVICE_ROLE_KEY=.' "$STAGED" || { echo 'service role key required' >&2; exit 2; }
    install -d -m 0700 -o root -g root /etc/web-manager/secrets
    install -m 0600 -o root -g root "$STAGED" /etc/web-manager/secrets/global.env
    rm -f "$STAGED"
    printf '%s\n' 'OK'
    ;;
  duckdns-apply)
    LABEL="${2:-}"
    DOMAINS_CSV="${3:-}"
    STAGED="${4:--}"
    [[ "$LABEL" =~ ^[a-z0-9_-]{1,40}$ ]] || { echo 'invalid label' >&2; exit 2; }
    [[ -n "$DOMAINS_CSV" ]] || { echo 'domains required' >&2; exit 2; }
    [[ -f /etc/web-manager/config.env ]] || { echo 'server config missing' >&2; exit 2; }
    SERVER_PUBLIC_IP="$(sed -n 's/^SERVER_PUBLIC_IP=//p' /etc/web-manager/config.env | head -n1)"
    [[ "$SERVER_PUBLIC_IP" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || { echo 'invalid SERVER_PUBLIC_IP' >&2; exit 2; }

    IFS=',' read -r -a DOMAINS <<<"$DOMAINS_CSV"
    ((${#DOMAINS[@]} >= 1 && ${#DOMAINS[@]} <= 50)) || { echo 'invalid domain count' >&2; exit 2; }
    SUBS=()
    for D in "${DOMAINS[@]}"; do
      [[ "$D" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.duckdns\.org$ ]] || { echo 'invalid DuckDNS domain' >&2; exit 2; }
      SUBS+=("${D%.duckdns.org}")
    done
    SUBDOMAINS="$(IFS=,; echo "${SUBS[*]}")"

    TARGET="/etc/web-manager/secrets/duckdns/${LABEL}.env"
    SOURCE="$TARGET"
    if [[ "$STAGED" != '-' ]]; then
      [[ "$STAGED" =~ ^/run/web-admin/duckdns-[0-9a-f-]{36}\.env$ ]] || { echo 'invalid staged credential' >&2; exit 2; }
      [[ -f "$STAGED" && ! -L "$STAGED" ]] || { echo 'invalid staged credential file' >&2; exit 2; }
      [[ "$(stat -c '%U' "$STAGED")" == 'webadmin' ]] || { echo 'invalid staged credential owner' >&2; exit 2; }
      SOURCE="$STAGED"
    fi
    [[ -f "$SOURCE" && ! -L "$SOURCE" ]] || { echo 'credential not found' >&2; exit 2; }

    DUCK_TOKEN="$(sed -n 's/^DUCKDNS_TOKEN=//p' "$SOURCE" | head -n1)"
    [[ "$DUCK_TOKEN" =~ ^[A-Za-z0-9-]{8,128}$ ]] || { echo 'invalid DuckDNS token format' >&2; exit 2; }

    RESULT="$(curl -fsS --max-time 15 --config - <<EOF
url = "https://www.duckdns.org/update"
get
data-urlencode = "domains=${SUBDOMAINS}"
data-urlencode = "token=${DUCK_TOKEN}"
data-urlencode = "ip=${SERVER_PUBLIC_IP}"
EOF
)" || { echo 'DuckDNS request failed' >&2; exit 3; }
    [[ "$RESULT" == 'OK' ]] || { echo 'DuckDNS rejected credential/domain update' >&2; exit 3; }

    if [[ "$STAGED" != '-' ]]; then
      install -d -m 0700 -o root -g root /etc/web-manager/secrets/duckdns
      install -m 0600 -o root -g root "$STAGED" "$TARGET"
      rm -f "$STAGED"
    fi
    unset DUCK_TOKEN
    printf '%s\n' 'OK'
    ;;
  *)
    echo 'unsupported privileged operation' >&2
    exit 2
    ;;
esac
