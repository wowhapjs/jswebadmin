#!/usr/bin/env bash
set -Eeuo pipefail

# Narrow privileged helper for the unprivileged web-admin service.
# This intentionally does NOT expose arbitrary shell execution.

CMD="${1:-}"
case "$CMD" in
  desktop-start)
    rm -f /run/desktop-commander-manual-stop
    systemctl start desktop-commander-remote.service
    ;;
  desktop-stop)
    printf '%s\n' 'manual stop via web-admin' > /run/desktop-commander-manual-stop
    chmod 0644 /run/desktop-commander-manual-stop
    systemctl stop desktop-commander-remote.service
    ;;
  duckdns-install)
    TARGET="${2:-}"
    SOURCE="${3:-}"
    [[ "$TARGET" == "/etc/web-manager/secrets/duckdns.env" || "$TARGET" =~ ^/etc/web-manager/secrets/duckdns/[a-z0-9_-]{1,40}\.env$ ]] || { echo 'invalid target' >&2; exit 2; }
    [[ "$SOURCE" =~ ^/run/web-admin/duckdns-[0-9a-f-]{36}\.env$ ]] || { echo 'invalid source' >&2; exit 2; }
    [[ -f "$SOURCE" && ! -L "$SOURCE" ]] || { echo 'invalid source file' >&2; exit 2; }
    [[ "$(stat -c '%U' "$SOURCE")" == "webadmin" ]] || { echo 'invalid source owner' >&2; exit 2; }
    install -d -m 0700 -o root -g root /etc/web-manager/secrets/duckdns
    install -m 0600 -o root -g root "$SOURCE" "$TARGET"
    rm -f "$SOURCE"
    ;;
  *)
    echo 'unsupported privileged operation' >&2
    exit 2
    ;;
esac
