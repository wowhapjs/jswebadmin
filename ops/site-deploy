#!/usr/bin/env bash
set -Eeuo pipefail

# GitHub-first production deploy runner.
# Usage: site-deploy <site-slug> <40-char-commit-sha>

SLUG="${1:-}"
SHA="${2:-}"
DB=(sudo -n -u ubuntu psql -q -U web_manager -d web_manager -At -F $'\t' -v ON_ERROR_STOP=1 -c)

fail(){ echo "ERROR: $*" >&2; exit 1; }
sql_escape(){ printf '%s' "$1" | sed "s/'/''/g"; }
psqlq(){ "${DB[@]}" "$1"; }
git_as(){ local owner="$1" repo="$2"; shift 2; sudo -n -u "$owner" git -C "$repo" "$@"; }
normalize_repo(){ printf '%s' "$1" | sed -E 's#\.git$##; s#/$##' | tr '[:upper:]' '[:lower:]'; }

[[ "$SLUG" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || fail "invalid slug"
[[ "$SHA" =~ ^[0-9a-fA-F]{40}$ ]] || fail "commit must be a full 40-character SHA"
SHA="${SHA,,}"

exec 9>"/run/lock/site-deploy-${SLUG}.lock"
flock -n 9 || fail "deployment already running for ${SLUG}"

ROW="$(psqlq "select s.id,s.server_path,coalesce(s.port,0),coalesce(d.hostname,''),coalesce(s.repo_url,''),coalesce(s.repo_branch,'main') from manager.sites s left join lateral (select hostname from manager.site_domains where site_id=s.id and is_primary=true limit 1) d on true where s.slug='$(sql_escape "$SLUG")' and s.archived_at is null limit 1")"
[[ -n "$ROW" ]] || fail "site not found: ${SLUG}"
IFS=$'\t' read -r SITE_ID REPO PORT DOMAIN REPO_URL BRANCH <<<"$ROW"
[[ -d "$REPO/.git" ]] || fail "not a git repository: ${REPO}"
[[ "$REPO_URL" =~ ^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(\.git)?$ ]] || fail "Manager DB repo_url is missing or invalid"
[[ "$BRANCH" =~ ^[A-Za-z0-9._/-]{1,128}$ ]] || fail "invalid repo branch"
OWNER="$(stat -c '%U' "$REPO")"
ORIGIN="$(git_as "$OWNER" "$REPO" remote get-url origin)"
[[ "$(normalize_repo "$ORIGIN")" == "$(normalize_repo "$REPO_URL")" ]] || fail "origin URL differs from Manager DB repo_url"

DIRTY="$(git_as "$OWNER" "$REPO" status --porcelain)"
[[ -z "$DIRTY" ]] || fail "working tree is dirty; server-side edits are forbidden"

git_as "$OWNER" "$REPO" fetch --prune origin "$BRANCH"
git_as "$OWNER" "$REPO" cat-file -e "${SHA}^{commit}" || fail "commit not found after fetch"
git_as "$OWNER" "$REPO" merge-base --is-ancestor "$SHA" "origin/$BRANCH" || fail "commit is not on origin/$BRANCH"
PREVIOUS="$(git_as "$OWNER" "$REPO" rev-parse HEAD)"

META="$(python3 - "$REPO_URL" "$PREVIOUS" "$BRANCH" <<'PY'
import json,sys
print(json.dumps({'repo_url':sys.argv[1],'previous_sha':sys.argv[2],'branch':sys.argv[3],'deployer':'chatgpt-main'}))
PY
)"
DEPLOY_ID="$(psqlq "insert into manager.deployments(site_id,source_commit,status,message,metadata,started_at) values ('$SITE_ID','$SHA','deploying','GitHub-first deploy','$(sql_escape "$META")'::jsonb,now()) returning id")"

mark_failed(){
  local msg="$1" status="${2:-failed}"
  psqlq "update manager.deployments set status='$(sql_escape "$status")',message='$(sql_escape "$msg")',finished_at=now() where id='$DEPLOY_ID'" >/dev/null || true
}

GLOBAL_ENV=/etc/web-manager/secrets/global.env
GLOBAL_OVERRIDE=/run/web-manager/site-deploy-${SLUG}-global-env.yml
COMPOSE_ARGS=()

prepare_compose(){
  COMPOSE_ARGS=(-f "$REPO/compose.yml")
  rm -f "$GLOBAL_OVERRIDE"
  [[ -f "$GLOBAL_ENV" ]] || return 0
  [[ ! -L "$GLOBAL_ENV" ]] || fail "global env must not be a symlink"
  [[ "$(stat -c '%U:%G:%a' "$GLOBAL_ENV")" == 'root:root:600' ]] || fail "global env permissions must be root:root 600"
  install -d -m 0755 -o root -g root /run/web-manager

  local targets
  targets="$(cd "$REPO" && docker compose --env-file "$GLOBAL_ENV" config --format json | python3 -c '
import json,sys
port=str(sys.argv[1]); data=json.load(sys.stdin); services=data.get("services",{})
matches=[]
for name,svc in services.items():
    for p in svc.get("ports") or []:
        if str(p.get("published", "")) == port:
            matches.append(name); break
if not matches and len(services)==1:
    matches=list(services)
if not matches:
    raise SystemExit(4)
for name in matches:
    print(name)
' "$PORT")" || fail "could not determine application service for global env injection"
  [[ -n "$targets" ]] || fail "no application service selected for global env injection"

  {
    printf '%s\n' 'services:'
    while IFS= read -r service; do
      [[ "$service" =~ ^[A-Za-z0-9_.-]+$ ]] || fail "invalid compose service name"
      printf '  "%s":\n' "$service"
      printf '%s\n' '    env_file:' '      - /etc/web-manager/secrets/global.env'
    done <<<"$targets"
  } >"$GLOBAL_OVERRIDE"
  chmod 0600 "$GLOBAL_OVERRIDE"
  COMPOSE_ARGS+=(-f "$GLOBAL_OVERRIDE")
}

preflight(){
  case "$SLUG" in
    web-admin)
      node --check "$REPO/server-v2.mjs" >/dev/null
      bash -n "$REPO/ops/web-admin-priv"
      bash -n "$REPO/ops/site-deploy"
      [[ -s "$REPO/app/index.html" ]]
      ;;
    *)
      [[ -f "$REPO/compose.yml" ]] || fail "compose.yml missing"
      prepare_compose
      if [[ -f "$GLOBAL_ENV" ]]; then
        (cd "$REPO" && docker compose --env-file "$GLOBAL_ENV" "${COMPOSE_ARGS[@]}" config -q)
      else
        (cd "$REPO" && docker compose "${COMPOSE_ARGS[@]}" config -q)
      fi
      ;;
  esac
}

activate(){
  case "$SLUG" in
    web-admin)
      install -m 0750 -o root -g root "$REPO/ops/web-admin-priv" /usr/local/sbin/web-admin-priv
      install -m 0750 -o root -g root "$REPO/ops/site-deploy" /usr/local/sbin/site-deploy
      systemctl restart web-admin.service
      ;;
    *)
      prepare_compose
      if [[ -f "$GLOBAL_ENV" ]]; then
        (cd "$REPO" && docker compose --env-file "$GLOBAL_ENV" "${COMPOSE_ARGS[@]}" up -d --remove-orphans)
      else
        (cd "$REPO" && docker compose "${COMPOSE_ARGS[@]}" up -d --remove-orphans)
      fi
      ;;
  esac
}

health(){
  local i code
  for i in {1..20}; do
    if curl -fsS --max-time 4 "http://127.0.0.1:${PORT}/" >/dev/null 2>&1; then break; fi
    sleep 1
  done
  curl -fsS --max-time 5 "http://127.0.0.1:${PORT}/" >/dev/null
  if [[ -n "$DOMAIN" ]]; then
    code="$(curl -sS --max-time 15 -o /dev/null -w '%{http_code}' "https://${DOMAIN}/" || true)"
    if [[ "$SLUG" == "web-admin" ]]; then
      [[ "$code" =~ ^(2|3)[0-9][0-9]$ || "$code" == "401" ]] || return 1
    else
      [[ "$code" =~ ^(2|3)[0-9][0-9]$ ]] || return 1
    fi
  fi
}

rollback(){
  echo "Deploy failed; rolling back ${SLUG} to ${PREVIOUS}" >&2
  git_as "$OWNER" "$REPO" reset --hard "$PREVIOUS" >/dev/null
  activate >/dev/null 2>&1 || true
  if health; then
    psqlq "update manager.sites set current_commit='$(sql_escape "$PREVIOUS")',updated_at=now() where id='$SITE_ID'; update manager.deployments set status='rolled_back',message='Deployment failed; automatically rolled back to $(sql_escape "$PREVIOUS")',finished_at=now(),metadata=metadata||'{\"rollback_ok\":true}'::jsonb where id='$DEPLOY_ID'" >/dev/null || true
    return 0
  fi
  mark_failed "Deployment failed and rollback health check also failed"
  return 1
}

trap 'rc=$?; if [[ $rc -ne 0 ]]; then rollback || true; fi; exit $rc' ERR

preflight
git_as "$OWNER" "$REPO" reset --hard "$SHA" >/dev/null
preflight
activate
health

psqlq "update manager.sites set current_commit='$SHA',updated_at=now() where id='$SITE_ID'; update manager.deployments set status='succeeded',message='Deployed and health-checked',finished_at=now(),metadata=metadata||'{\"local_health\":true,\"public_health\":true}'::jsonb where id='$DEPLOY_ID'" >/dev/null
trap - ERR

echo "DEPLOY_OK slug=${SLUG} sha=${SHA} previous=${PREVIOUS}"
